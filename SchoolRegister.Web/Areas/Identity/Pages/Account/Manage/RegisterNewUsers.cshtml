@page
@model RegisterNewUsersDataModel

<h4>Register new users</h4>

<style>
    .student-selected,
    .teacher-selected {
        display: none;
    }
</style>

<form method="post">

    <input asp-for="NewUserVm.Email" class="form-control" placeholder="Email" />
    <input asp-for="NewUserVm.Password" class="form-control" placeholder="Password" />
    <input asp-for="NewUserVm.ConfirmPassword" class="form-control" placeholder="Confirm Password" />
    <input asp-for="NewUserVm.FirstName" class="form-control" placeholder="First Name" />
    <input asp-for="NewUserVm.LastName" class="form-control" placeholder="Last Name" />

    <!-- ROLE -->
    <select id="roleSelect"
            asp-for="NewUserVm.RoleId"
            class="form-control"
            onchange="updateFields()"
            asp-items="@ViewData["Roles"] as IEnumerable<SelectListItem>">
    </select>

    <!-- STUDENT -->
    <div class="student-selected">
        <select asp-for="NewUserVm.GroupId" class="form-control"
                asp-items="@ViewData["Groups"] as IEnumerable<SelectListItem>">
        </select>

        <select asp-for="NewUserVm.ParentId" class="form-control"
                asp-items="@ViewData["Parents"] as IEnumerable<SelectListItem>">
        </select>
    </div>

    <!-- TEACHER -->
    <div class="teacher-selected">
        <input asp-for="NewUserVm.TeacherTitles"
               class="form-control"
               placeholder="Teacher titles" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Register</button>

</form>

@section Scripts {
<script>
    function updateFields() {

        var roleSelect = document.getElementById("roleSelect");
        var studentFields = document.querySelector(".student-selected");
        var teacherFields = document.querySelector(".teacher-selected");

        var selectedText = roleSelect.options[roleSelect.selectedIndex].text;

        console.log("Wybrana rola:", selectedText); // debug

        // reset
        studentFields.style.display = "none";
        teacherFields.style.display = "none";

        if (selectedText === "Student") {
            studentFields.style.display = "block";
        }

        if (selectedText === "Teacher") {
            teacherFields.style.display = "block";
        }
    }

    // uruchom po załadowaniu strony
    window.onload = updateFields;
</script>
}