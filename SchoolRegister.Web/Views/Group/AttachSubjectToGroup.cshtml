@model SchoolRegister.ViewModels.VM.AttachDetachSubjectGroupVm

@{
    ViewData["Title"] = "Attach Subject to Group";
}

<h2>Attach Subject to Group</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-action="AttachSubjectToGroup" method="post">
            <input type="hidden" asp-for="SubjectId" />

            <div class="form-group mb-3">
                <label class="control-label">Select Group:</label>
                <select asp-for="GroupId" class="form-control" asp-items="ViewBag.GroupsSelectList"></select>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Attach</button>
                <a asp-controller="Subject" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>