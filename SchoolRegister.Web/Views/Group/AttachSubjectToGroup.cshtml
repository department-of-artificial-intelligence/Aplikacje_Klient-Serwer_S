@{
    ViewData["Title"] = "Przypisz przedmiot do grupy";
    var subject = ViewBag.Subject as SchoolRegister.ViewModels.VM.SubjectVm;
    var availableGroups = ViewData["AvailableGroups"] as SelectList;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Przypisz przedmiot do grupy</h4>
                </div>
                <div class="card-body">
                    <h5>Przedmiot: <strong class="text-primary">@subject?.Name</strong></h5>
                    <p class="text-muted">Wybierz grupę z listy, do której chcesz przypisać ten przedmiot.</p>
                    
                    <form asp-controller="Group" asp-action="AttachSubjectToGroup" method="post" class="mt-4">
                        <input type="hidden" name="subjectId" value="@subject?.Id" />

                        <div class="form-group mb-4">
                            <label class="form-label font-weight-bold">Dostępne grupy:</label>
                            <select name="groupId" asp-items="availableGroups" class="form-select" required>
                                <option value="">-- Wybierz grupę --</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Subject" asp-action="Index" class="btn btn-secondary">Anuluj</a>
                            <button type="submit" class="btn btn-success"><i class="fas fa-link"></i> Przypisz przedmiot</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>