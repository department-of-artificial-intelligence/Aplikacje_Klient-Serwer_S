@using SchoolRegister.ViewModels.VM
@model AttachDetachSubjectGroupVm

@{
    ViewData["Title"] = "Attach Subject to Group";
}

<h2>Attach Subject to Group</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AttachSubjectToGroup">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="GroupId" type="hidden" />

            <div class="form-group mb-3">
                <label class="control-label">Subject</label>
                <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.SubjectsSelectList">
                    <option value="">-- Select Subject --</option>
                </select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Attach" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}