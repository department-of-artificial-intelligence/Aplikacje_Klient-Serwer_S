@{
    ViewData["Title"] = "Attach Subject to Group";
}
<h2>Attach Subject to Group</h2>
<div class="row">
    <div class="col-md-4">
        <form asp-action="AttachSubjectToGroup">
            <input type="hidden" name="SubjectId" value="@ViewBag.SubjectId" />
            <div class="form-group">
                <label>Group</label>
                <select name="GroupId" class="form-control"
                    asp-items="@ViewBag.GroupsSelectList"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Attach" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<a asp-controller="Subject" asp-action="Index">Back to List</a>
