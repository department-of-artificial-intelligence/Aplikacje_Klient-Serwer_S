@model IEnumerable<SchoolRegister.ViewModels.VM.GroupVm>

<h2>Zarządzanie grupami (klasami)</h2>

<p>
    <a asp-action="AddOrEditGroup" class="btn btn-success">Dodaj nową grupę</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nazwa grupy</th>
            <th>Opis</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model)
        {
            <tr>
                <td>@group.Name</td>
                <td>
                    <a asp-action="AddOrEditGroup" asp-route-id="@group.Id" class="btn btn-sm btn-warning">Edytuj</a>
                    <a asp-action="ManageGroupStudents" asp-route-id="@group.Id" class="btn btn-sm btn-primary">Studenci</a>
                </td>
            </tr>
        }
    </tbody>
</table>