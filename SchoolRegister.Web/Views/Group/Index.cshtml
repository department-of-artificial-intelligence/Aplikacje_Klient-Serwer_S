@model IEnumerable<SchoolRegister.ViewModels.VM.GroupVm>
@{
    ViewData["Title"] = "Groups";
}
<h2>Groups</h2>
<p>
    <a asp-action="AddOrEditGroup">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Students Count</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model)
        {
            <tr>
                <td>@group.Name</td>
                <td>@(group.Students?.Count ?? 0)</td>
                <td>
                    <a asp-action="AddOrEditGroup" asp-route-id="@group.Id">Edit</a> |
                    <a asp-action="AttachStudentToGroup">Attach Student</a> |
                    <a asp-action="DetachStudentFromGroup">Detach Student</a>
                </td>
            </tr>
        }
    </tbody>
</table>
