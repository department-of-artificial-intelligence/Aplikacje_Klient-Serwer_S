@model IEnumerable<SchoolRegister.ViewModels.VM.GroupVm>

<h2>Groups</h2>

<p>
    <a asp-action="AddOrEditGroup">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Students Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Name</td>
            <td>@item.Students.Count</td>
            <td>
                <a asp-action="AddOrEditGroup" asp-route-id="@item.Id">Edit</a> |

                @* <a asp-action="AttachStudentToGroup"
                   asp-route-studentId="1"
                   asp-route-groupId="@item.Id">
                   Add Student
                </a> |

                <a asp-action="DetachStudentFromGroup"
                   asp-route-studentId="1"
                   asp-route-groupId="@item.Id">
                   Remove Student
                </a> *@

                <!-- ADD STUDENT -->
                <form asp-action="AttachStudentToGroup" method="get">
                    <input type="hidden" name="groupId" value="@item.Id">
                    <select name="studentId">
                        @foreach (var s in ViewBag.Students)
                        {
                            <option value="@s.Id">@s.FirstName @s.LastName</option>
                        }
                    </select>
                    <button type="submit">Add</button>
                </form>

                <!-- REMOVE STUDENT -->
                <form asp-action="DetachStudentFromGroup" method="get">
                    <input type="hidden" name="groupId" value="@item.Id">
                    <select name="studentId">
                        @foreach (var s in item.Students)
                        {
                            <option value="@s.Id">@s.FirstName @s.LastName</option>
                        }
                    </select>
                    <button type="submit">Remove</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>