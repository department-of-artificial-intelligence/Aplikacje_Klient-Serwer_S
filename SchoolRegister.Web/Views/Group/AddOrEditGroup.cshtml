@model SchoolRegister.ViewModels.VM.AddOrUpdateGroupVm

@{
    ViewData["Title"] = $"{ViewBag.ActionType} grupę";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@ViewBag.ActionType grupę</h4>
                </div>
                <div class="card-body">
                    <form asp-action="AddOrEditGroup" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label font-weight-bold">Nazwa grupy</label>
                            <input asp-for="Name" class="form-control" placeholder="Wpisz nazwę grupy" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Powrót do listy
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Zapisz zmiany
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
