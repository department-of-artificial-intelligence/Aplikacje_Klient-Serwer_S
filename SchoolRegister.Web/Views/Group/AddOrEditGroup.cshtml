@model SchoolRegister.ViewModels.VM.AddOrUpdateGroupVm

<div class="container mt-4">
    <h2>@(ViewBag.ActionType == "Add" ? "Dodaj nową grupę" : "Edytuj grupę")</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="AddOrEditGroup" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label">Nazwa grupy</label>
                    <input asp-for="Name" class="form-control" placeholder="np. 1A" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">Zapisz</button>
                    <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
                </div>
            </form>
        </div>
    </div>
</div>