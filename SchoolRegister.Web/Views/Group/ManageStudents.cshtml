@model SchoolRegister.ViewModels.VM.GroupVm

@{
    ViewData["Title"] = "Manage Students";
}

<h2>@Model.Name</h2>
<hr />

<div class="row mb-4">
    <div class="col-md-6">
        <form asp-action="AttachStudent" method="post" class="d-flex align-items-center">
            <input type="hidden" name="GroupId" value="@Model.Id" />
            <select name="StudentId" class="form-control me-2" asp-items="ViewBag.AvailableStudents">
                <option value="">-- Select Student --</option>
            </select>
            <button type="submit" class="btn btn-success">Attach</button>
        </form>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Students != null && Model.Students.Any())
        {
            foreach (var student in Model.Students)
            {
                <tr>
                    <td class="align-middle">@student.FirstName</td>
                    <td class="align-middle">@student.LastName</td>
                    <td class="text-end">
                        <form asp-action="DetachStudent" method="post">
                            <input type="hidden" name="GroupId" value="@Model.Id" />
                            <input type="hidden" name="StudentId" value="@student.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Detach</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No students in this group.</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>