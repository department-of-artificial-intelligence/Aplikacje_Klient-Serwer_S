@using SchoolRegister.ViewModels.VM
@model AttachDetachStudentToGroupVm

@{
    ViewData["Title"] = "Remove Student from Group";
}

<h2>Remove Student from Group</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="DetachStudentFromGroup">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="GroupId" type="hidden" />

            <div class="form-group mb-3">
                <label class="control-label">Student</label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.StudentsSelectList">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Remove" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}