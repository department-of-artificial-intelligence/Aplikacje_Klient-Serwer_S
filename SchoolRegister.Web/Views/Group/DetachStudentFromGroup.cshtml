@{
    ViewData["Title"] = "Detach Student from Group";
}
<h2>Detach Student from Group</h2>
<div class="row">
    <div class="col-md-4">
        <form asp-action="DetachStudentFromGroup">
            <div class="form-group">
                <label>Student</label>
                <select name="StudentId" class="form-control"
                    asp-items="@ViewBag.StudentsSelectList"></select>
            </div>
            <div class="form-group">
                <label>Group</label>
                <select name="GroupId" class="form-control"
                    asp-items="@ViewBag.GroupsSelectList"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Detach" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<a asp-action="Index">Back to List</a>
