@model SchoolRegister.ViewModels.VM.GroupVm

@{
    ViewData["Title"] = "Group Details";
}

<h2>Group: @Model.Name</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <h4>Students in this group</h4>
        <table class="table">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.StudentsInGroup != null)
                {
                    foreach (var student in ViewBag.StudentsInGroup)
                    {
                        <tr>
                            <td>@student.FirstName</td>
                            <td>@student.LastName</td>
                            <td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="DetachStudentFromGroup" asp-route-student_id="@student.Id" asp-route-group_id="@Model.Id" class="text-danger">Remove</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-4">
        @if (User.IsInRole("Admin"))
        {
            <div class="card card-body bg-light">
                <h4>Add student to group</h4>
                <form asp-action="AttachStudentToGroup" method="get">
                    <input type="hidden" name="group_id" value="@Model.Id" />
                    <div class="form-group mb-2">
                        <select name="student_id" class="form-control" asp-items="ViewBag.AvailableStudents">
                            <option value="">-- Select Student --</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Add Student</button>
                </form>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>