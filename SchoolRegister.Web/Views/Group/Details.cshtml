@model SchoolRegister.ViewModels.VM.GroupVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Group details";
}

<h1>@Model.Name</h1>

<div class="row mt-4">
    <div class="col-md-7">
        <h4>Studenci w grupie</h4>

        @if (Model.Students != null && Model.Students.Any())
        {
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Imię</th>
                        <th>Nazwisko</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>@student.FirstName</td>
                        <td>@student.LastName</td>
                        <td>
                            <form asp-action="RemoveStudentFromGroup" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="GroupId" value="@Model.Id" />
                                <input type="hidden" name="StudentId" value="@student.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Usuń</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">Brak studentów w grupie.</p>
        }

        <h5 class="mt-3">Dodaj studenta</h5>
        @if (ViewBag.AvailableStudents != null && 
             ((IEnumerable<SelectListItem>)ViewBag.AvailableStudents).Any())
        {
            <form asp-action="AddStudentToGroup" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="GroupId" value="@Model.Id" />
                <div class="input-group">
                    <select name="StudentId" class="form-select">
                        @foreach (var s in (IEnumerable<SelectListItem>)ViewBag.AvailableStudents)
                        {
                            <option value="@s.Value">@s.Text</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-success">Dodaj</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted">Brak dostępnych studentów do dodania.</p>
        }
    </div>

    <div class="col-md-5">
        <h4>Przedmioty</h4>
        @if (Model.Subjects != null && Model.Subjects.Any())
        {
            <ul class="list-group">
                @foreach (var subject in Model.Subjects)
                {
                    <li class="list-group-item">@subject.Name</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Brak przedmiotów przypisanych do grupy.</p>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-4">Back</a>