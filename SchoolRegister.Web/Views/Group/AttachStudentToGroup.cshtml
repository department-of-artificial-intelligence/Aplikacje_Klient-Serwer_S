@using SchoolRegister.ViewModels.VM
@model AttachDetachStudentToGroupVm

@{
    ViewData["Title"] = "Dodaj studenta do grupy";
}

<h2>Dodaj studenta do grupy</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AttachStudentToGroup">
            <input asp-for="GroupId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">Student</label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.StudentsSelectList"></select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<a asp-action="Index">Powrót do listy grup</a>