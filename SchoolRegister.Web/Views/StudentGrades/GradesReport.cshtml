@model SchoolRegister.ViewModels.VM.GradesReportVm
@{
    ViewData["Title"] = "Dziennik Ocen";
}

<div class="card p-4 mb-4 bg-light">
    <h2>Dziennik ucznia: @Model.Student.FirstName @Model.Student.LastName</h2>
    <p class="mb-1"><strong>Klasa:</strong> @(Model.Student.GroupName ?? "Nieprzypisany")</p>
    <p class="mb-1"><strong>Login/Email:</strong> @Model.Student.UserName</p>
    <p class="mb-0"><strong>Średnia całkowita:</strong> <span class="badge bg-info text-dark fs-6">@Model.Student.AverageGrade.ToString("0.00")</span></p>
</div>

<h3>Oceny z podziałem na przedmioty</h3>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th style="width: 30%;">Przedmiot</th>
            <th style="width: 55%;">Oceny cząstkowe</th>
            <th style="width: 15%; text-align: center;">Średnia przedmiotu</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Student.GradesPerSubject == null || !Model.Student.GradesPerSubject.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">Brak danych o ocenach.</td>
            </tr>
        }
        else
        {
            foreach (var subject in Model.Student.GradesPerSubject)
            {
                <tr>
                    <td><strong>@subject.Key</strong></td>
                    <td>
                        @foreach (var gradeValue in subject.Value)
                        {
                            <span class="badge bg-success me-1 fs-6">@gradeValue</span>
                        }
                    </td>
                    <td class="text-center fw-bold">
                        @(Model.Student.AverageGradePerSubject.ContainsKey(subject.Key) 
                            ? Model.Student.AverageGradePerSubject[subject.Key].ToString("0.00") 
                            : "-")
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="mt-3">
    @if (User.IsInRole("Parent"))
    {
        <a asp-controller="StudentGrades" asp-action="Index" class="btn btn-secondary">Powrót do listy dzieci</a>
    }
    else if (User.IsInRole("Teacher"))
    {
        <a asp-controller="Grade" asp-action="AddGrade" class="btn btn-secondary">Powrót do wystawiania ocen</a>
    }
    else
    {
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Powrót do strony głównej</a>
    }
</div>