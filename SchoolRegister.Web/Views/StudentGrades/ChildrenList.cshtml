@model IEnumerable<SchoolRegister.ViewModels.VM.StudentVm>
@{
    ViewData["Title"] = "Wybierz dziecko";
}

<h2>Twoje dzieci w systemie</h2>
<hr />

<div class="list-group">
    @foreach (var child in Model)
    {
        <a asp-action="ViewChildGrades" asp-route-studentId="@child.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
                <strong>@child.FirstName @child.LastName</strong> <br/>
                <small class="text-muted">Klasa: @(child.GroupName ?? "Brak") | Ogólna średnia: @child.AverageGrade.ToString("0.00")</small>
            </div>
            <span class="badge bg-primary rounded-pill">Pokaż dziennik</span>
        </a>
    }
</div>