@using SchoolRegister.ViewModels.VM
@model StudentVm

@{
    ViewData["Title"] = "Student Details";
}

<h2>@Model.FirstName @Model.LastName</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Username</dt>
    <dd class="col-sm-9">@Model.UserName</dd>

    <dt class="col-sm-3">Group</dt>
    <dd class="col-sm-9">@(Model.GroupName ?? "—")</dd>

    <dt class="col-sm-3">Parent</dt>
    <dd class="col-sm-9">@(Model.ParentName ?? "—")</dd>

    <dt class="col-sm-3">Overall Average</dt>
    <dd class="col-sm-9"><strong>@Model.AverageGrade.ToString("F2")</strong></dd>
</dl>

@if (Model.GradesPerSubject != null && Model.GradesPerSubject.Any())
{
    <h4 class="mt-4">Grades by Subject</h4>
    <table class="table table-sm table-bordered">
        <thead class="table-secondary">
            <tr>
                <th>Subject</th>
                <th>Grades</th>
                <th>Average</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.GradesPerSubject)
            {
                <tr>
                    <td>@entry.Key</td>
                    <td>@string.Join(", ", entry.Value)</td>
                    <td>
                        @if (Model.AverageGradePerSubject != null &&
                                                     Model.AverageGradePerSubject.ContainsKey(entry.Key))
                        {
                            @Model.AverageGradePerSubject[entry.Key].ToString("F2")
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted mt-3">No grades yet.</p>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">← Back to list</a>
    @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
    {
        <a asp-controller="Grade" asp-action="AddGrade" asp-route-studentId="@Model.Id" class="btn btn-success ms-2">+ Add
            Grade</a>
        }
    </div>