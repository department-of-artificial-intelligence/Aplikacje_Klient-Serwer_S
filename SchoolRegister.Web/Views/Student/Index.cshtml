@model SchoolRegister.ViewModels.VM.GradesReportVm

@{
    ViewData["Title"] = "My Grades";
}

<h1>My Grades</h1>

<table class="table">
    <thead>
        <tr>
            <th>Subject ID</th>
            <th>Grade</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Grades)
        {
            <tr>
                <td>@item.SubjectId</td>
                <td>@item.GradeValue</td>
            </tr>
        }
    </tbody>
</table>