@model IEnumerable<SchoolRegister.ViewModels.VM.StudentVm>

<h2>Students</h2>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Group</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.FirstName</td>
            <td>@item.LastName</td>
            <td>@item.GroupName</td>
        </tr>
}
    </tbody>
</table>