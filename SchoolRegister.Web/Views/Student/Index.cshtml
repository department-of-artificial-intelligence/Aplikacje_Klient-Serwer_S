@model IEnumerable<SchoolRegister.ViewModels.VM.StudentVm>

<h2>Students</h2>

<table class="table">
    <thead>
        <tr>
            <th>Student Credentials</th>
            <th>Email</th>
            <th>Parent Credentials</th>
            <th>Parent Email</th>
            <th>Group</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.FirstName @item.LastName</td>
            <td>@item.Email</td>
            <td>@item.ParentName</td>
            <td>@item.ParentEmail</td>
            <td>@item.GroupName</td>
        </tr>
}
    </tbody>
</table>