@model SchoolRegister.ViewModels.VM.SubjectVm

@{
    ViewData["Title"] = "Subject Details";
}

<h2>Subject Details</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Teacher</dt>
        <dd class="col-sm-9">@Model.TeacherName</dd>
    </dl>
</div>

@if (Model.Groups != null && Model.Groups.Any())
{
    <h4>Grupy</h4>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Nazwa grupy</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model.Groups)
            {
                <tr>
                    <td>@group.Name</td>
                    <td>
                        <a asp-controller="Group" asp-action="Details"
                           asp-route-id="@group.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Brak przypisanych grup.</p>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>