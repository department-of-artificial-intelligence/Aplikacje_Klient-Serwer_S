@model SchoolRegister.ViewModels.VM.SubjectVm

@{
    ViewData["Title"] = "Szczegóły przedmiotu";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0">Szczegóły przedmiotu: @Model.Name</h3>
        </div>
        <div class="card-body">
            <dl class="row fs-5">
                <dt class="col-sm-3 font-weight-bold">ID przedmiotu:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3 font-weight-bold">Nazwa:</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 font-weight-bold">Opis:</dt>
                <dd class="col-sm-9 text-muted">@Model.Description</dd>

                <dt class="col-sm-3 font-weight-bold">Prowadzący nauczyciel:</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.TeacherName) ? "Brak przypisanego nauczyciela" : Model.TeacherName)</dd>
            </dl>

            <hr />

            <h4>Przypisane grupy/klasy</h4>
            @if (Model.Groups != null && Model.Groups.Any())
            {
                <ul class="list-group col-md-6 mb-4">
                    @foreach (var group in Model.Groups)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-users text-secondary me-2"></i> @group.Name</span>
                            <a asp-controller="Group" asp-action="ManageGroupStudents" asp-route-id="@group.Id" class="btn btn-sm btn-outline-primary">Zobacz uczniów</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="alert alert-warning col-md-6">Ten przedmiot nie jest jeszcze przypisany do żadnej grupy.</div>
            }

            <div class="mt-3">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="AddOrEditSubject" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit"></i> Edytuj</a>
                }
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Powrót do listy</a>
            </div>
        </div>
    </div>
</div>