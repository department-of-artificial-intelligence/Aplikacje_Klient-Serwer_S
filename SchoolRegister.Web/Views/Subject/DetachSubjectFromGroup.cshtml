@model SchoolRegister.ViewModels.VM.AddOrUpdateSubjectVm

@{
    ViewData["Title"] = "Detach Group from " + ViewBag.SubjectName;
}

<h2>Detach Group from @ViewBag.SubjectName</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="DetachSubjectFromGroup">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="form-group">
                <label class="control-label">Select Group to Remove</label>
               
                <select name="SelectedGroupId" class="form-control" asp-items="@ViewBag.GroupsSelectList">
                    <option value="">-- Select Group to Detach --</option>
                </select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Detach" class="btn btn-danger" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
