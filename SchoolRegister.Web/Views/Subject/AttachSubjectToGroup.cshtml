@model SchoolRegister.ViewModels.VM.AddOrUpdateSubjectVm

@{
    ViewData["Title"] = "Attach Group to " + ViewBag.SubjectName;
}

<h2>Attach Group to @ViewBag.SubjectName</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AttachSubjectToGroup">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="form-group">
                <label class="control-label">Select Group</label>
        
                <select name="SelectedGroupId" class="form-control" asp-items="@ViewBag.GroupsSelectList">
                    <option value="">-- Select Group --</option>
                </select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Attach" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
