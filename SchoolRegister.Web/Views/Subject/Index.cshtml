@using SchoolRegister.ViewModels.VM
@model IEnumerable<SubjectVm>

@{
    ViewData["Title"] = "Index";
}

<h2>Subject</h2>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="AddOrEditSubject">Create New</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.TeacherName)</th>
            <th>Groups Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>

@foreach (var item in Model)
{
    <tr>
        <td>@item.Name</td>
        <td>@item.Description</td>
        <td>@item.TeacherName</td>
        <td>@item.Groups.Count</td>

        <td>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="AddOrEditSubject" asp-route-id="@item.Id">Edit</a> @:|

            <!-- ATTACH -->
            <form asp-controller="Subject" asp-action="AttachSubjectToGroup" method="post" style="display:inline;">
                <input type="hidden" name="subjectId" value="@item.Id" />

                <select name="groupId">
                    @foreach (var g in ViewBag.Groups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>

                <button type="submit">Add</button>
            </form> @:|

            <form asp-controller="Subject" asp-action="DetachSubjectFromGroup" method="post" style="display:inline;">
                <input type="hidden" name="subjectId" value="@item.Id" />

                <select name="groupId">
                    @foreach (var g in item.Groups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>

                <button type="submit">Remove</button>
            </form> @:|
        }

        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
        </td>
    </tr>
}

    </tbody>
</table>