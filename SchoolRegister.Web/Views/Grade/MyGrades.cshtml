@model IEnumerable<SchoolRegister.ViewModels.VM.GradeVm>
@{
    ViewData["Title"] = "My Grades";
}
<h2>My Grades</h2>
<table class="table">
    <thead>
        <tr>
            <th>Subject</th>
            <th>Grade</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var grade in Model)
            {
                <tr>
                    <td>@grade.SubjectName</td>
                    <td>@grade.GradeValue</td>
                    <td>@grade.DateOfIssue.ToShortDateString()</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3">No grades available.</td>
            </tr>
        }
    </tbody>
</table>