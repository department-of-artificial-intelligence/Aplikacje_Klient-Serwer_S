@model IEnumerable<SchoolRegister.ViewModels.VM.GradeVm>

<h2>My Grades</h2>

<table class="table">
    <thead>
        <tr>
            <th>Subject Name</th>
            <th>Subject ID</th>
            <th>Grade</th>
            <th>Teacher</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.SubjectName</td>
            <td>@item.SubjectId</td>
            <td>@item.GradeValue</td>
            <td>@item.TeacherName</td>
            <td>@item.DateOfIssue.ToShortDateString()</td>
        </tr>
}
    </tbody>
</table>