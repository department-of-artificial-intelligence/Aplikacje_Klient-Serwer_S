@model SchoolRegister.ViewModels.VM.GradesReportVm

@{
    ViewData["Title"] = "Moje Oceny";
}

<h2>Raport Ocen</h2>
<hr />

<div>
    <h4>Uczeń: @Model.StudentFullName</h4>
    <h5>Grupa: @Model.GroupName</h5>
    <h5>Średnia ocen: <span class="badge bg-success">@Model.AverageGrade</span></h5>
</div>

<br />

<table class="table table-striped">
    <thead>
        <tr>
            <th>Przedmiot</th>
            <th>Ocena</th>
            <th>Data</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Grades != null && Model.Grades.Any())
        {
            foreach (var grade in Model.Grades)
            {
                <tr>
                    <td>@grade.SubjectName</td>
                    <td>@grade.GradeValue</td>
                    <td>@grade.DateOfIssue.ToShortDateString()</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center text-muted">Brak ocen.</td>
            </tr>
        }
    </tbody>
</table>