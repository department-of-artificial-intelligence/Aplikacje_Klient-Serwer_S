@model IEnumerable<SchoolRegister.ViewModels.VM.GradesReportVm>

@{
    ViewData["Title"] = "Raport ocen";
}

<h2>Raport ocen</h2>

@if (!Model.Any())
{
    <p class="text-muted">Brak danych do wyświetlenia.</p>
}

@foreach (var report in Model)
{
    <div class="card mb-4">
        <div class="card-header">
            <strong>@report.Student?.FirstName @report.Student?.LastName</strong>
        </div>
        <div class="card-body">
            @if (report.Grades != null && report.Grades.Any())
            {
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Przedmiot</th>
                            <th>Ocena</th>
                            <th>Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grade in report.Grades)
                        {
                            <tr>
                                <td>@grade.Subject?.Name</td>
                                <td>@grade.GradeValue</td>
                                <td>@grade.DateOfIssue.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Brak ocen.</p>
            }
        </div>
    </div>
}