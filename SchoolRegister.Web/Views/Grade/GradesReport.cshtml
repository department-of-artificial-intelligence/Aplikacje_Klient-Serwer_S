@model SchoolRegister.ViewModels.VM.GradesReportVm

@{
    ViewData["Title"] = "Grades Report";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mt-4">
        <h2>Report for @Model.StudentName</h2>
        <span class="badge bg-secondary fs-5">Group: @Model.GroupName</span>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-12">
            @if (Model.Grades != null && Model.Grades.Any())
            {
                <table class="table table-striped table-hover mt-3">
                    <thead class="table-dark">
                        <tr>
                            <th>Subject</th>
                            <th>Grade Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grade in Model.Grades)
                        {
                            <tr>
                                <td>@grade.SubjectName</td>
                                <td>
                                    <span class="fw-bold">@grade.GradeValue</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <td colspan="1" class="text-end"><strong>Total Average:</strong></td>
                            <td colspan="2"><strong>@Model.AverageGrade.ToString("F2")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <div class="alert alert-warning">
                    No grades found for this student.
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" asp-controller="Student" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Students
        </a>
        <a asp-action="AddGrade" asp-route-studentId="@Context.Request.Query["studentId"]" class="btn btn-primary">
            Add New Grade
        </a>
    </div>
</div>