@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm

<div class="container mt-4">
    <h2>Wystaw ocenę</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="AddGradeToStudent" method="post">
                <input type="hidden" asp-for="StudentId" />
                <input type="hidden" asp-for="TeacherId" />

                <div class="form-group mb-3">
                    <label asp-for="SubjectId" class="control-label">Wybierz swój przedmiot</label>
                    <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.SubjectsSelectList"></select>
                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="GradeValue" class="control-label">Ocena</label>
                    <select asp-for="GradeValue" class="form-control" asp-items="ViewBag.GradeValues"></select>
                    <span asp-validation-for="GradeValue" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">Zapisz ocenę</button>
                    <a href="javascript:history.back()" class="btn btn-secondary">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>