@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm

@{
    ViewData["Title"] = "AddGradeToStudent";
}

<h1>AddGradeToStudent</h1>

<h4>AddGradeToStudentVm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
    <form asp-action="AddGradeToStudent">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="StudentId" />
        <input type="hidden" asp-for="TeacherId" />

        <div class="form-group mb-3">
            <label asp-for="SubjectId" class="control-label">Przedmiot</label>
            <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.SubjectsSelectList">
                <option value="">-- Wybierz przedmiot --</option>
            </select>
            <span asp-validation-for="SubjectId" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="GradeValue" class="control-label">Ocena</label>
            <select asp-for="GradeValue" class="form-control" 
                    asp-items="Html.GetEnumSelectList<SchoolRegister.Model.DataModels.GradeScale>()">
                <option value="">-- Wybierz ocenę --</option>
            </select>
            <span asp-validation-for="GradeValue" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="submit" value="Wystaw ocenę" class="btn btn-primary" />
        </div>
    </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-route-studentId="@Model.StudentId">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}