@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm
@{
    ViewData["Title"] = "Add Grade";
}
<h2>Add Grade</h2>
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddGrade">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="StudentId" type="hidden" />
            <div class="form-group">
                <label asp-for="SubjectId" class="control-label"></label>
                <select asp-for="SubjectId" class="form-control"
                    asp-items="@(new SelectList(ViewBag.Subjects, "Id", "Name"))"></select>
            </div>
            <div class="form-group">
                <label asp-for="GradeValue" class="control-label"></label>
                <select asp-for="GradeValue" class="form-control"
                    asp-items="Html.GetEnumSelectList<SchoolRegister.Model.DataModels.GradeScale>()"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Add Grade" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<a asp-controller="Student" asp-action="Index">Back to List</a>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
