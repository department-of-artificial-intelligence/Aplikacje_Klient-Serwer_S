@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm

<h2>Add Grade</h2>

<form asp-action="AddGrade">

    <div class="form-group">
        <label>Student</label>
        <select asp-for="StudentId" asp-items="@ViewBag.Students" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Subject</label>
        <select asp-for="SubjectId" asp-items="@ViewBag.Subjects" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Grade</label>
        <input asp-for="GradeValue" class="form-control" />
    </div>

    <br />

    <input type="submit" value="Add" class="btn btn-primary" />
</form>