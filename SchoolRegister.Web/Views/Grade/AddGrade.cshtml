@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm

@{
    ViewData["Title"] = "Add Grade";
}

<h2>Issue a new grade</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddGrade">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="StudentId" class="control-label">Student</label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.Students">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SubjectId" class="control-label">Subject</label>
                <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.Subjects">
                    <option value="">-- Select Subject --</option>
                </select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GradeValue" class="control-label">Grade</label>
                <select asp-for="GradeValue" class="form-control">
                    <option value="">-- Select Grade --</option>
                    <option value="2">2 (Insufficient)</option>
                    <option value="3">3 (Sufficient)</option>
                    <option value="4">4 (Good)</option>
                    <option value="5">5 (Very Good)</option>
                </select>
                <span asp-validation-for="GradeValue" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Grade" class="btn btn-primary w-100" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}