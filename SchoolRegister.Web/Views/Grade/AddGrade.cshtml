@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm
@using SchoolRegister.Model.DataModels
@{
    ViewData["Title"] = "Add Grade";
}
<h2>Add Grade to Student</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddGrade" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="StudentId" type="hidden" />
            <div class="form-group">
                <label asp-for="SubjectId" class="control-label">SubjectId</label>
                <select asp-for="SubjectId" class="form-control" asp-items="@(new SelectList( ViewBag.Subjects, "Id", "Name"))">
                    <option value="">Select a subject</option>
                </select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GradeValue" class="control-label">Grade</label>
                <select asp-for="GradeValue" asp-items="Html.GetEnumSelectList<GradeScale>()" class="form-control">
                    <option value="">Select a grade</option>
                </select>
                <span asp-validation-for="GradeValue" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Add Grade" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index" asp-controller="Student">Back to Students</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}