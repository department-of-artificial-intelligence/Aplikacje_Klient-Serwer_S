@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm
@{
    ViewData["Title"] = "Add Grade";
}

<h2>Add New Grade</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddGrade">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label class="control-label">Subject</label>
                <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.SubjectsSelectList"></select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Student</label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.StudentsSelectList"></select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Grade</label>
                <select asp-for="GradeValue" class="form-control" asp-items="ViewBag.GradesSelectList"></select>
                <span asp-validation-for="GradeValue" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Add Grade" class="btn btn-primary" />
                <a asp-controller="Subject" asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>